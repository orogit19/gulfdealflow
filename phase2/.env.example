SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
CSV_PATH=../phase1/gcc_ventures_master_v4.csv
OPENAI_API_KEY=your-openai-api-key
# Recommended in production. Enter this value manually in the Review workspace;
# never expose it through a frontend VITE_* environment variable.
ADMIN_API_KEY=optional-shared-admin-key
# Optional but recommended for Vercel Cron. Use a random value of at least 16 characters.
CRON_SECRET=optional-random-cron-secret
# Comma-separated frontend origins. Use your Vercel URL in production.
CORS_ORIGINS=http://localhost:5173
ARTICLE_FETCH_TIMEOUT_SECONDS=20
ARTICLE_FETCH_MAX_BYTES=5000000
